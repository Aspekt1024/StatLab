# Store text as LF in the repo; check out with the platform's native endings
* text=auto

# Source and docs
*.cs      text diff=csharp
*.md      text
*.json    text
*.xml     text
*.csv     text
*.yml     text
*.yaml    text

# Visual Studio files need CRLF
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Shell scripts must stay LF
*.sh      text eol=lf

# Binary
*.png     binary
*.jpg     binary
*.dll     binary
*.exe     binary
